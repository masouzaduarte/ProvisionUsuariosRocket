# Rocket.Chat
RC_BASE_URL=https://rocketchat.mds.gov.br
RC_ADMIN_USER=
RC_ADMIN_PASSWORD=

# Canal padrão de entrada dos usuários criados (único).
# joinDefaultChannels=false na API — não entram em #general etc.
# Se RC_ROOM_ID estiver vazio, resolve pelo nome (padrão SNAS).
# Se ambos forem preenchidos, o ID deve corresponder ao nome (validação na Fase 1).
RC_ROOM_ID=6a675ef65c7e20d0153c03af
RC_ROOM_NAME=SNAS

# SMTP
SMTP_HOST=smtp.exemplo.gov.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@mds.gov.br
SMTP_FROM_NAME=Rocket.Chat MDS

# Processamento
BATCH_SIZE=100
DELAY_MS=100
MAX_RETRIES=3
DRY_RUN=false

# Segurança: se true, NÃO grava senha em sucesso.csv (recomendado)
STORE_PASSWORD_IN_SUCCESS=false

# Colunas do CSV de entrada (ajuste se a planilha usar outros nomes)
# Username no Rocket = CPF (coluna cpf). Não há coluna username.
CSV_COL_NAME=nome
CSV_COL_EMAIL=email
CSV_COL_CPF=cpf
